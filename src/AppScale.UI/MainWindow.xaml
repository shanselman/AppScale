<Window x:Class="AppScale.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppScale (experimental) — per-app scale controller"
        Width="1280" Height="860" MinWidth="980" MinHeight="640"
        FontFamily="{StaticResource UiFont}" FontSize="13" Background="#F3F3F3">
    <Grid x:Name="Root" Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="20,14,20,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E6F2E6"
                        ToolTip="The background watcher applies your remembered apps' scale every time they start (only while AppScale is running, enabled and not emergency-disabled).">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWatching}" Value="False">
                                    <Setter Property="Background" Value="#EDEDED" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding WatchingText, StringFormat=● {0}}" FontWeight="SemiBold" />
                </Border>
                <Button Content="Reset all" Command="{Binding ResetAllCommand}" ToolTip="Reset every override applied in this session and close all previews." />
                <Button Content="Emergency disable" Style="{StaticResource DangerButton}" Margin="0" Command="{Binding EmergencyCommand}"
                        ToolTip="Reset everything (including cooperative windows from earlier sessions) and block all further changes." />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="AppScale" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Foreground="{StaticResource Subtle}" TextWrapping="Wrap" Text="Pick an app, choose a scale, Apply now — or Remember it and AppScale tells the app a different monitor DPI every time it starts, so it re-renders natively. Never changes display settings." />
            </StackPanel>
        </DockPanel>

        <!-- Emergency banner -->
        <Border Grid.Row="1" Margin="20,0,20,8" Background="#FDE7E9" BorderBrush="#C42B1C" BorderThickness="1" CornerRadius="6" Padding="12,8"
                Visibility="{Binding EmergencyDisabled, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clear emergency disable" Margin="0" Command="{Binding ClearEmergencyCommand}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#8A1C11" FontWeight="SemiBold"
                           Text="Emergency disable is ON — all overrides were reset and nothing can be applied, previewed or launched until you clear it (also available under Settings &amp; safety)." />
            </DockPanel>
        </Border>

        <!-- Consent -->
        <ScrollViewer Grid.Row="2" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding NeedsConsent, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Top" Padding="28,22">
                <StackPanel>
                    <TextBlock Text="Enable AppScale?" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="AppScale is an experimental utility that lets you choose a scale (75–250 %) for one application, independently of your monitor. Nothing is changed until you click Enable, and you can turn it off again at any time under Settings &amp; safety." />
                    <TextBlock Text="What AppScale does" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="12,0,0,8" LineHeight="20">
                        • You pick an app and a scale. AppScale makes that app believe its monitor has the DPI you chose, so it re-renders natively (sharp text, real layout) — a demo of per-app scaling Windows could support.<LineBreak />
                        • Cooperative applications (that implement the AppScale protocol) are simply asked to re-render. For ordinary apps, AppScale loads its small DPI adapter into <Run FontWeight="SemiBold">only the app you picked</Run>; it lives in that process only and is gone when the app exits.<LineBreak />
                        • If you choose Remember, AppScale runs in the tray, watches for that executable and applies your scale each time it starts. You confirm this per app; remembered apps are listed under Profiles and can be turned off or deleted.<LineBreak />
                        • When no native method works, you can explicitly open a clearly-labelled visual magnification window: a read-only DWM bitmap preview, not native rendering, with no input forwarding.
                    </TextBlock>
                    <TextBlock Text="What AppScale never does" FontWeight="SemiBold" Margin="0,4,0,4" />
                    <TextBlock TextWrapping="Wrap" Margin="12,0,0,12" LineHeight="20">
                        • No global display or scaling changes.  • No elevation / administrator rights.  • No telemetry or network access.<LineBreak />
                        • Never loads anything into an app you did not pick or remember; nothing system-wide, no persistence inside apps.  • Never silently switches from native to bitmap scaling.<LineBreak />
                        • Never touches elevated, protected, shell, security or password-manager processes, and never saves other apps' content.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Enable AppScale" Style="{StaticResource AccentButton}" Padding="20,8" Command="{Binding EnableCommand}" />
                        <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Subtle}" Margin="8,0,0,0"
                                   Text="{Binding SettingsPath, StringFormat=Settings are stored at {0}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Main content -->
        <TabControl Grid.Row="2" Margin="20,0,20,0" Background="Transparent" BorderThickness="0" Padding="0,10,0,0"
                    x:Name="Tabs">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NeedsConsent}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>

            <TabItem Header="  Scale a window  ">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="430" />
                    </Grid.ColumnDefinitions>

                    <!-- Picker -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Refresh" Margin="0" Command="{Binding RefreshCommand}" />
                                    <TextBlock Text="Windows" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WindowCountText}" Foreground="{StaticResource Subtle}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </DockPanel>
                                <DataGrid x:Name="WindowGrid" ItemsSource="{Binding Windows}" SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0"
                                          Background="White" RowHeaderWidth="0" CanUserResizeRows="False">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
                                            <Setter Property="ToolTip" Value="{Binding Status}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                                    <Setter Property="Foreground" Value="#9A9A9A" />
                                                    <Setter Property="Background" Value="#F7F7F7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Executable" Width="210">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2">
                                                        <TextBlock Text="{Binding ExecutableName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="150" />
                                        <DataGridTextColumn Header="Win DPI" Binding="{Binding WindowDpi}" Width="Auto" />
                                        <DataGridTextColumn Header="Mon DPI" Binding="{Binding MonitorDpi}" Width="Auto" />
                                        <DataGridTextColumn Header="Awareness" Binding="{Binding Awareness}" Width="Auto" />
                                        <DataGridTextColumn Header="Coop." Binding="{Binding Cooperative}" Width="Auto" />
                                        <DataGridTextColumn Header="Status / exclusion" Binding="{Binding Status}" Width="190" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Launch an executable at a scale" Style="{StaticResource CardTitle}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="Executable…" Command="{Binding BrowseExeCommand}" />
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource AccentButton}" Command="{Binding LaunchInjectCommand}"
                                            Content="{Binding ScalePercent}" ContentStringFormat="Launch with scale {0}%"
                                            ToolTip="For apps that read DPI only at startup: runs AppScale.Injector --launch so the DPI adapter is loaded before the first window." />
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Command="{Binding LaunchCommand}"
                                            Content="{Binding ScalePercent}" ContentStringFormat="Cooperative launch {0}%"
                                            ToolTip="Starts the program with APPSCALE_DPI set (restart-required path; only cooperative apps honour it)." />
                                    <TextBlock Text="{Binding LaunchPath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding LaunchPath}" />
                                </DockPanel>
                                <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource Subtle}" TextWrapping="Wrap"
                                           Text="Launch with scale loads AppScale's DPI adapter into the new process (for apps that cache DPI at startup). Cooperative launch only sets APPSCALE_DPI. The Experimental Detours flag only affects the owned Win32 harness." />
                                <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding InjectorText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Right column -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="Scale" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding ScalePercent, StringFormat={}{0}%}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Slider Minimum="75" Maximum="250" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25"
                                            Value="{Binding ScalePercent, Mode=TwoWay}" TickPlacement="BottomRight" AutomationProperties.Name="Scale percent" />
                                    <ItemsControl ItemsSource="{Binding PresetValues}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding StringFormat={}{0}%}" Margin="0,0,4,0" Padding="4,4"
                                                        Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Absolute DPI" ToolTip="What a cooperative app is asked to render at: 96 × scale. Independent of the monitor." />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Value}" FontWeight="SemiBold" Text="{Binding AbsoluteText}" />
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Relative zoom" ToolTip="Requested DPI ÷ the window's actual DPI. Used only for bitmap magnification." />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding RelativeText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Status" Style="{StaticResource CardTitle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource Label}" Text="Target" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource Value}" Text="{Binding TargetText}" />
                                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding TargetPath}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Actual DPI" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding MonitorText}" />
                                        <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Requested" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Value}" Text="{Binding RequestedText}" />
                                        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="Backend" />
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Style="{StaticResource Value}" FontWeight="SemiBold" Text="{Binding BackendText}" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Text="{Binding CapabilitiesText}" />
                                            <TextBlock FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding BackendDetail}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Restart" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RestartText, TargetNullValue='—'}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Value}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RestartRequired}" Value="True">
                                                            <Setter Property="Foreground" Value="#9D5D00" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0" Background="#FFF4CE" BorderBrush="#E0B030" BorderThickness="1"
                                                CornerRadius="4" Padding="10,6" Visibility="{Binding CompatibilityUnknown, Converter={StaticResource BoolVis}}">
                                            <TextBlock TextWrapping="Wrap" Foreground="#6B4A00"
                                                       Text="⚠ Compatibility unknown: this app does not implement the AppScale cooperative protocol. AppScale can try its injected DPI adapter (shown as backend 'inject' above); results depend on how the app handles DPI changes. If no native method works, only an explicitly chosen visual magnification preview (bitmap, read-only) is possible." />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Actions" Style="{StaticResource CardTitle}" />
                                    <WrapPanel>
                                        <Button Content="Apply now" Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" ToolTip="Apply natively now (cooperative or injected adapter, chosen automatically). Never falls back to bitmap scaling silently." />
                                        <Button Content="Remember (auto-apply on start)…" Command="{Binding RememberCommand}" ToolTip="Saves an ENABLED profile for this executable; the tray watcher applies it every time the app starts. Asks for confirmation." />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Content="Preview" Command="{Binding PreviewCommand}" ToolTip="Visual magnification preview — bitmap, not native rendering, read-only. Applies nothing." />
                                        <Button Content="Reset" Command="{Binding ResetCommand}" />
                                        <Button Content="Close previews" Command="{Binding ClosePreviewsCommand}" />
                                    </WrapPanel>
                                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Subtle}" Text="{Binding RememberText}" />
                                    <Border Margin="0,8,0,0" Background="#EAF3FB" BorderBrush="#7FB2E0" BorderThickness="1" CornerRadius="4" Padding="10,6"
                                            Visibility="{Binding HasInjectConsent, Converter={StaticResource BoolVis}}">
                                        <TextBlock TextWrapping="Wrap" Foreground="#0B4A80" Text="{Binding InjectConsentText}" />
                                    </Border>
                                    <Border Margin="0,10,0,0" Background="#FFF4CE" BorderBrush="#E0B030" BorderThickness="1" CornerRadius="4" Padding="10,8"
                                            Visibility="{Binding ShowVisualFallback, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" Foreground="#6B4A00"
                                                       Text="No native backend can scale this window. You can explicitly choose visual magnification instead: a separate, read-only bitmap window (DWM thumbnail). Text will be blurrier and input is not forwarded." />
                                            <Button Content="Use visual magnification instead" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding ApplyVisualCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Text="{Binding LastResultText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0F7B0F" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastResultIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="#C42B1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="  Profiles  ">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Remembered apps (per-executable profiles)" Style="{StaticResource CardTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Subtle}" Margin="0,0,0,8"
                                       Text="Profiles are keyed by full executable path and stored locally. An ENABLED profile means: while AppScale is running in the tray, every time that executable starts the watcher applies its scale natively (cooperative protocol, or AppScale's DPI adapter loaded into that app). Untick Enabled to stop. Visual magnification is never auto-applied." />
                            <WrapPanel>
                                <Button Content="Save selected window + scale (disabled)" Command="{Binding SaveProfileCommand}" />
                                <Button Content="Export to JSON…" Command="{Binding ExportCommand}" />
                                <Button Content="Delete all settings &amp; profiles…" Style="{StaticResource DangerButton}" Command="{Binding DeleteAllCommand}" />
                            </WrapPanel>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Profiles}" AutoGenerateColumns="False" HeadersVisibility="Column" BorderThickness="0"
                                  CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" Background="White">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Enabled" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Executable" Binding="{Binding ExecutableName}" IsReadOnly="True" Width="160" />
                                <DataGridTextColumn Header="Auto-apply" Binding="{Binding AutoText}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Path" Binding="{Binding ExecutablePath}" IsReadOnly="True" Width="*" />
                                <DataGridTextColumn Header="Scale %" Binding="{Binding ScalePercent}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Backend" Binding="{Binding Backend}" IsReadOnly="True" Width="Auto" />
                                <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" IsReadOnly="True" Width="Auto" />
                                <DataGridTemplateColumn Header="" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2">
                                                <Button Content="Apply profile" Padding="8,2"
                                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                                <Button Content="Delete" Padding="8,2"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="  Applied  ">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Applied — what AppScale told each app" Style="{StaticResource CardTitle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Subtle}"
                                       Text="Every apply (manual, profile, launch, and automatic on app start) with the backend used, the DPI the app now renders at versus the DPI Windows actually gives it, and the failure reason if it did not work. Newest first." />
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding AppliedRows}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="0"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" Background="White" RowHeaderWidth="0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Succeeded}" Value="False">
                                            <Setter Property="Foreground" Value="#C42B1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="Auto" />
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="Auto" />
                                <DataGridTextColumn Header="Executable" Binding="{Binding ExecutableName}" Width="170" />
                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="Auto" />
                                <DataGridTextColumn Header="Backend" Binding="{Binding Backend}" Width="Auto" />
                                <DataGridTextColumn Header="Effective vs OS DPI" Binding="{Binding DpiText}" Width="Auto" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="Auto" />
                                <DataGridTextColumn Header="Detail / failure reason" Binding="{Binding Detail}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <TabItem Header="  Settings &amp; safety  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Opt-in" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="AppScale is enabled. Turning it off resets every override applied in this session, closes previews and blocks Apply until you enable it again." />
                                <Button Content="Turn AppScale off" HorizontalAlignment="Left" Command="{Binding OptOutCommand}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Emergency disable" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="Resets all overrides (including cooperative windows changed by an earlier session) and blocks all changes until cleared. Also available from the tray icon." />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Emergency disable" Style="{StaticResource DangerButton}" Command="{Binding EmergencyCommand}" />
                                    <Button Content="Clear emergency disable" Command="{Binding ClearEmergencyCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Feature flags" Style="{StaticResource CardTitle}" />
                                <CheckBox IsChecked="{Binding VisualPreviewEnabled}" Margin="0,0,0,4"
                                          Content="Visual preview — allow the read-only DWM thumbnail magnification window (bitmap, not native rendering)" />
                                <CheckBox IsChecked="{Binding InjectionEnabled}" Margin="0,0,0,4"
                                          Content="Injection — load AppScale's DPI adapter into apps you pick or remember (per process, gone when the app exits)" />
                                <TextBlock Margin="22,0,0,6" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Text="{Binding InjectorText}" />
                                <CheckBox IsChecked="{Binding ExperimentalDetoursEnabled}"
                                          Content="Experimental Detours (research) — only affects launching the owned Win32 harness via 'Cooperative launch'" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Privacy &amp; storage" Style="{StaticResource CardTitle}" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding SettingsPath, StringFormat=Settings file (atomic writes): {0}}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource Subtle}"
                                           Text="No telemetry, no network. The DPI adapter is loaded only into apps you picked (Apply now / Launch with scale) or remembered (enabled profile), only while AppScale runs; nothing is installed system-wide and it unloads when the app exits. Visual previews are composed by DWM directly into AppScale's window; AppScale never reads, saves or transmits other applications' pixels. Export and delete are on the Profiles tab." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Log -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,4,20,16" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Results &amp; log (every ScaleResult, newest first)" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Log}" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter Property="Foreground" Value="#C42B1C" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
